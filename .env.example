# Copy to .env and adjust. Never commit .env.
POSTGRES_PASSWORD=genscr
# Host port for Postgres; change if 5432 is taken (then update DATABASE_URL too)
DB_PORT=5432
DATABASE_URL=postgresql://genscr:genscr@localhost:5432/genscr
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_NAME=genScr
# Grievance/contact email shown on the Privacy and Terms pages (required before public launch)
NEXT_PUBLIC_CONTACT_EMAIL=
# Forward-looking return scenarios are OFF by default. Enable only after legal review (SEBI rules).
NEXT_PUBLIC_ENABLE_PROJECTIONS=false

# Seconds between NSE archive requests during backfills. Be polite.
REQUEST_DELAY_SECONDS=1.5
